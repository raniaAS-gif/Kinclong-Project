<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxWidth="1152.0" minHeight="-Infinity" minWidth="-Infinity" prefWidth="1152.0" style="-fx-background-color: #EEF6FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="30.0" left="32.0" right="32.0" top="30.0" />
   </padding>
   <children>
      <VBox>
         <children>
            <Label text="Edit Pelanggan" textFill="#2f4a6b">
               <font>
                  <Font name="Plus Jakarta Sans ExtraBold" size="40.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <Region prefHeight="30.0" />
      <HBox alignment="CENTER_LEFT">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="1088.0" style="-fx-background-color: #FAFCFE; -fx-background-radius: 100; -fx-border-color: #D5E5F3; -fx-border-width: 1; -fx-border-radius: 100;">
               <children>
                  <TextField fx:id="searchBarUpdate" onAction="#handleSearch" prefHeight="50.0" prefWidth="1003.0" promptText="Cari Nama/Nomor Telepon/ID Pelanggan" style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Inter 24pt Regular" size="15.0" />
                     </font>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </TextField>
                  <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handleSearch" prefHeight="50.0" prefWidth="78.0" style="-fx-background-color: #5B96D3; -fx-background-radius: 1000;">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../../assets/icons8-search-90%20(1).png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
            <Region prefWidth="10.0" />
         </children>
      </HBox>
      <Region prefHeight="30.0" />
      <TableView prefHeight="420.0" style="-fx-background-color: #FAFCFE; -fx-background-radius: 10; -fx-border-color: #5B96D3; -fx-border-radius: 10;">
         <columns>
            <TableColumn fx:id="coloumID" prefWidth="132.0" text="ID Pelanggan" />
            <TableColumn fx:id="coloumNamaPelanggan" prefWidth="332.0" text="Nama Pelanggan" />
            <TableColumn fx:id="coloumTelepon" prefWidth="233.5" text="No Telepon" />
            <TableColumn fx:id="coloumAlamat" prefWidth="365.5" text="Alamat" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <stylesheets>
            <URL value="@../../styleTabel.css" />
            <URL value="@../../../../css/styleTabel.css" />
         </stylesheets>
      </TableView>
      <Region prefHeight="30.0" />
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button alignment="CENTER" mnemonicParsing="false" prefWidth="120.0" style="-fx-background-color: #5b96d3; -fx-background-radius: 100;" text="Batalkan" textFill="#fafefc">
               <font>
                  <Font name="Plus Jakarta Sans SemiBold" size="20.0" />
               </font>
            </Button>
            <Region prefWidth="10.0" />
            <Button alignment="CENTER" mnemonicParsing="false" prefWidth="120.0" style="-fx-background-color: #5b96d3; -fx-background-radius: 100;" text="Simpan" textFill="#fafefc">
               <font>
                  <Font name="Plus Jakarta Sans SemiBold" size="20.0" />
               </font>
            </Button>
         </children>
      </HBox>
